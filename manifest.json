{
  "manifest_version": 3,
  "name": "墟 · AI Assistant",
  "short_name": "XU-AI",
  "version": "0.2.0",
  "description": "在 XU 阅读页面旁快速打开你已登录的 AI 官网，并自动排列左右窗口。",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "system.display",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://xu.lucifer-cgl.workers.dev/*",
    "https://lucifer.gicp.fun/*",
    "https://raw.githubusercontent.com/Lucifer-cgl/XU-AI-Assistant/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开墟 · AI Assistant"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xu.lucifer-cgl.workers.dev/*",
        "https://lucifer.gicp.fun/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
